// ───────────────────────────────────────────────────────────────
// Namma School ERP — Database Schema (MULTI-TENANT SaaS)
//
// This is a multi-tenant SaaS: ONE database serves MANY schools, and
// each school's data is isolated via a `schoolId` on every record.
// See docs/04-multi-tenancy.md for the full design.
//
// Think of each "model" below as a table, and each field as a column.
// ───────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles. SUPER_ADMIN is the SaaS owner (spans all schools); the rest are
// scoped to a single school.
enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum PaymentMode {
  CASH
  UPI
  CARD
  NETBANKING
  CHEQUE
}

enum Plan {
  FREE
  PRO
}

// ── SCHOOL (the TENANT) ────────────────────────────────────────
// Each row is one school using the platform. Everything else belongs
// to a school via `schoolId`. This is the heart of multi-tenancy.
model School {
  id            String   @id @default(cuid())
  // URL-friendly unique identifier, e.g. "dps-bangalore" (for subdomains later)
  slug          String   @unique
  name          String
  tagline       String?  @default("One source of truth for the entire school")
  affiliation   String?  @default("CBSE")
  academicYear  String   @default("2025-2026")
  address       String?
  city          String?  @default("Bengaluru")
  state         String?  @default("Karnataka")
  phone         String?
  email         String?
  website       String?
  principalName String?
  upiId         String? // school's own UPI ID for 0%-charge fee collection
  plan          Plan     @default(FREE)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users        User[]
  classes      SchoolClass[]
  students     Student[]
  attendance   Attendance[]
  feeStructure FeeStructure[]
  payments     FeePayment[]
}

// ── USERS ──────────────────────────────────────────────────────
// Everyone who logs in. Belongs to one school (except SUPER_ADMIN, whose
// schoolId is null). Password stored HASHED, never plain text.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Tenant link. Null only for SUPER_ADMIN (the SaaS owner).
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherOfClasses SchoolClass[] @relation("ClassTeacher")
  markedAttendance Attendance[]  @relation("MarkedBy")
  children         Student[]     @relation("ParentOfStudent")
  studentProfile   Student?      @relation("StudentAccount")

  @@index([schoolId])
}

// ── SCHOOL CLASS ───────────────────────────────────────────────
model SchoolClass {
  id           String   @id @default(cuid())
  name         String
  section      String
  academicYear String
  createdAt    DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classTeacherId String?
  classTeacher   User?   @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  students     Student[]
  attendance   Attendance[]
  feeStructure FeeStructure[]

  // Unique WITHIN a school (two schools can both have "Class 5 - A").
  @@unique([schoolId, name, section, academicYear])
  @@index([schoolId])
}

// ── STUDENT ────────────────────────────────────────────────────
model Student {
  id            String   @id @default(cuid())
  admissionNo   String
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  gender        String
  bloodGroup    String?
  guardianName  String
  guardianPhone String
  address       String?
  admissionDate DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classId     String?
  schoolClass SchoolClass? @relation(fields: [classId], references: [id])

  parentId String?
  parent   User?   @relation("ParentOfStudent", fields: [parentId], references: [id])

  userId String? @unique
  user   User?   @relation("StudentAccount", fields: [userId], references: [id])

  attendance Attendance[]
  payments   FeePayment[]

  // Admission number unique WITHIN a school.
  @@unique([schoolId, admissionNo])
  @@index([schoolId])
}

// ── ATTENDANCE ─────────────────────────────────────────────────
model Attendance {
  id        String           @id @default(cuid())
  date      DateTime
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id])

  markedById String
  markedBy   User   @relation("MarkedBy", fields: [markedById], references: [id])

  @@unique([studentId, date])
  @@index([schoolId])
}

// ── FEE STRUCTURE ──────────────────────────────────────────────
model FeeStructure {
  id           String   @id @default(cuid())
  title        String
  amount       Decimal  @db.Decimal(10, 2)
  dueDate      DateTime
  academicYear String
  createdAt    DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id])

  @@index([schoolId])
}

// ── FEE PAYMENT ────────────────────────────────────────────────
model FeePayment {
  id        String      @id @default(cuid())
  amount    Decimal     @db.Decimal(10, 2)
  paidOn    DateTime    @default(now())
  mode      PaymentMode
  receiptNo String
  note      String?
  createdAt DateTime    @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Receipt number unique WITHIN a school.
  @@unique([schoolId, receiptNo])
  @@index([schoolId])
}
