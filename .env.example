# ──────────────────────────────────────────────────────────────
# SchoolSetu — Environment Variables TEMPLATE
#
# HOW TO USE:
#   1. Copy this file to ".env"   ->   cp .env.example .env
#   2. Fill in the real values (get them from Neon, generate a secret, etc.)
#   3. NEVER commit the real .env file — it's in .gitignore for safety.
#
# These are "secrets" — like passwords for your infrastructure. They live
# in environment variables, not in the code, so they never end up on GitHub.
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string from Neon (Dashboard -> Connection Details)
# Looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/schoolsetu?schema=public"

# A long random secret used to encrypt login sessions.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# The public URL of the app (http://localhost:3000 in dev; your Vercel URL in prod)
NEXTAUTH_URL="http://localhost:3000"
